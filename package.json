{
  "name": "token-usage-monitor-demo",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "description": "Local dashboard demo for API relay token usage monitoring",
  "type": "commonjs",
  "scripts": {
    "app": "node launcher.js",
    "floating": "node scripts/start-floating.js",
    "web": "node launcher.js --web",
    "start": "node launcher.js --web",
    "test": "node --test \"test/*.test.js\"",
    "desktop": "node launcher.js",
    "dist:win": "electron-builder --win --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.tokenwatch.monitor",
    "productName": "Token Watch",
    "asar": true,
    "files": [
      "electron-main.js",
      "server.js",
      "codex-account.js",
      "usage-query.js",
      "outbound-network.js",
      "overview-stats.js",
      "history-calibration.js",
      "history-export.js",
      "source-attribution.js",
      "station-accounting.js",
      "model-pricing.js",
      "harness-usage.js",
      "workbuddy-usage.js",
      "usage-store.js",
      "scripts/extract-harness-usage.js",
      "public/**/*",
      "data/stations.json",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "public/icons/token-watch.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Token-Watch-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Token-Watch-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Token-Watch-${version}-${arch}-Portable.${ext}"
    }
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "chart.js": "^4.6.1",
    "lucide": "^0.468.0",
    "quickjs-emscripten": "^0.32.0",
    "smol-toml": "^1.8.0",
    "sql.js": "^1.14.2",
    "undici": "^6.29.1"
  }
}
